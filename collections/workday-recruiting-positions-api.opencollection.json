{
  "opencollection": "1.0.0",
  "info": {
    "name": "Workday Recruiting REST Applicants Positions API",
    "version": "v41.2"
  },
  "request": {
    "auth": {
      "type": "oauth2",
      "flow": "authorization_code",
      "authorizationUrl": "https://{tenant}.workday.com/authorize",
      "accessTokenUrl": "https://{tenant}.workday.com/ccx/oauth2/token",
      "credentials": {
        "clientId": "{{clientId}}",
        "clientSecret": "{{clientSecret}}"
      }
    }
  },
  "items": [
    {
      "info": {
        "name": "Positions",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Workday Recruiting List Positions",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://{tenant}.workday.com/ccx/api/recruiting/v41.2/positions",
            "params": [
              {
                "name": "limit",
                "value": "20",
                "type": "query",
                "description": "Maximum number of results to return per page"
              },
              {
                "name": "offset",
                "value": "0",
                "type": "query",
                "description": "Number of results to skip for pagination"
              }
            ]
          },
          "docs": "Retrieve position management positions including position details, restrictions, and associated job requisitions."
        },
        {
          "info": {
            "name": "Workday Recruiting Create a Position",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://{tenant}.workday.com/ccx/api/recruiting/v41.2/positions",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Create and open a new position using the position management staffing model. The position can subsequently be associated with a job requisition for recruiting."
        }
      ]
    }
  ],
  "bundled": true
}